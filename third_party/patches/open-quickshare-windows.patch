+pub fn host_name() -> Result<String, anyhow::Error> { Ok(std::env::var("COMPUTERNAME").or_else(|_| std::env::var("HOSTNAME")).unwrap_or_else(|_| "Next Share".into())) }
+
+// UKey2 coordinates are signed big-endian integers; SEC1 needs fixed-width unsigned values.
+pub fn p256_sec1(x: &[u8], y: &[u8]) -> Result<[u8; 65], anyhow::Error> {
+    let mut point=[0u8;65];point[0]=4;
+    for (coordinate,start) in [(x,1usize),(y,33usize)] {
+        let unsigned=if coordinate.len()==33 && coordinate[0]==0 {&coordinate[1..]} else {coordinate};
+        if unsigned.is_empty() || unsigned.len()>32 {return Err(anyhow!("Invalid P256 coordinate length"));}
+        point[start+32-unsigned.len()..start+32].copy_from_slice(unsigned);
+    }
+    Ok(point)
+}
