<Application x:Class="NextShare.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" ShutdownMode="OnExplicitShutdown">
 <Application.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries>
   <md:CustomColorTheme BaseTheme="Light" PrimaryColor="#006B60" SecondaryColor="#4A635D"/>
   <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="Surface" Color="#F4FAF7"/>
  <SolidColorBrush x:Key="SurfaceContainer" Color="#E8F3EE"/>
  <SolidColorBrush x:Key="SurfaceHigh" Color="#E1EDE7"/>
  <SolidColorBrush x:Key="Primary" Color="#006B60"/>
  <SolidColorBrush x:Key="PrimaryContainer" Color="#C2EAE0"/>
  <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Ink" Color="#17201C"/>
  <SolidColorBrush x:Key="Muted" Color="#54645D"/>
  <SolidColorBrush x:Key="Outline" Color="#B7C9C0"/>
  <SolidColorBrush x:Key="ErrorColor" Color="#A43E2B"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI, Nirmala UI"/></Style>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBar}">
   <Setter Property="md:ScrollBarAssist.ButtonsVisibility" Value="Collapsed"/><Setter Property="md:ScrollBarAssist.ThumbWidth" Value="6"/><Setter Property="md:ScrollBarAssist.ThumbCornerRadius" Value="3"/>
  </Style>
  <Style x:Key="ToastAction" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}"><Setter Property="Foreground" Value="#83D5C2"/></Style>
  <Style x:Key="BodyText" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="RoundedOutlineButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
   <Setter Property="md:ButtonAssist.CornerRadius" Value="24"/><Setter Property="Foreground" Value="{DynamicResource Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Outline}"/><Setter Property="Padding" Value="18,10"/><Setter Property="Height" Value="42"/>
  </Style>
  <Style x:Key="RoundIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="md:ButtonAssist.CornerRadius" Value="24"/>
  </Style>
  <Style x:Key="NavItem" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="NavBorder" CornerRadius="26" Padding="20,14" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SurfaceHigh}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource PrimaryContainer}"/><Setter Property="Foreground" Value="{DynamicResource Primary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource Primary}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary></Application.Resources>
</Application>
