<Window x:Class="NextShare.App.ReceiveNotification"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 Width="356" Height="104" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
 ShowActivated="False" Topmost="True" Focusable="False" WindowStartupLocation="Manual"
 FontFamily="Segoe UI, Nirmala UI" Title="Next Share · File received">
 <Border x:Name="Card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}"
  BorderThickness="1" CornerRadius="20" Margin="4" Padding="16,12" RenderTransformOrigin="0.5,0.5">
  <Border.RenderTransform><TranslateTransform x:Name="Slide"/></Border.RenderTransform>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Image Source="Assets/nextshare-logo.png" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Next Share logo"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <TextBlock x:Name="Phase" Text="NEXT SHARE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" Margin="0,0,0,4"/>
    <TextBlock x:Name="FileTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="FileDetail" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
