<Window x:Class="NextShare.Installer.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Next Share Setup" Width="790" Height="540" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" Foreground="{StaticResource Ink}" UseLayoutRounding="True">
 <Border x:Name="Shell" CornerRadius="26" Background="#F4FBF8" BorderBrush="#D5E9E2" BorderThickness="1" Margin="8">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border CornerRadius="25,0,0,25">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#064C43"/><GradientStop Color="#007A69" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid Margin="28">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="NEXT SHARE" Foreground="#B5EADC" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Closer.&#10;Connected." Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,18,0,0" LineHeight="38"/></StackPanel>
     <Grid Grid.Row="1" Width="184" Height="184" VerticalAlignment="Center">
      <Ellipse Stroke="#329A88" StrokeThickness="1" Margin="8"/>
      <Ellipse x:Name="Pulse" Stroke="#5DB7A2" StrokeThickness="1" Margin="25" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform x:Name="PulseScale"/></Ellipse.RenderTransform></Ellipse>
      <Grid x:Name="Orbit" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform x:Name="Rotation"/></Grid.RenderTransform>
       <Ellipse Width="12" Height="12" Fill="#C6FCE9" VerticalAlignment="Top"/>
       <Ellipse Width="8" Height="8" Fill="#8BE1C4" VerticalAlignment="Bottom"/>
       <Ellipse Width="6" Height="6" Fill="#69C5B0" HorizontalAlignment="Left"/>
      </Grid>
      <Border Width="104" Height="104" CornerRadius="32" Background="#F3FFF9"><Image Source="Assets/logo.png" Width="76" Height="76" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
     </Grid>
     <StackPanel Grid.Row="2"><TextBlock Text="Local files. Original quality." Foreground="#D0F1E5" FontSize="12"/><TextBlock x:Name="VersionText" Text="WINDOWS · SETUP" Foreground="#90C9B7" FontSize="10" Margin="0,8,0,0"/></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="32,28,30,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕" Click="Close_Click" Background="Transparent" Foreground="#58736D" Padding="10,5" AutomationProperties.Name="Close installer"/><Border Background="#DDF1E8" CornerRadius="10" Padding="10,5" HorizontalAlignment="Left"><TextBlock x:Name="Badge" Text="WELCOME" FontSize="10" FontWeight="SemiBold" Foreground="#076451"/></Border></DockPanel>
    <Grid x:Name="Body" Grid.Row="1" Margin="0,26,0,18">
     <StackPanel x:Name="WelcomePanel">
      <TextBlock Text="A little setup.&#10;A lot less waiting." FontSize="27" FontWeight="SemiBold" LineHeight="35"/>
      <TextBlock Text="Make this PC ready for nearby sharing." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,12,0,22"/>
      <Border Background="White" CornerRadius="18" Padding="18,14"><StackPanel>
       <TextBlock Text="✓   Quick Share &amp; Bluetooth receiving" FontSize="13"/>
       <TextBlock Text="✓   Starts with Windows, receiving on" FontSize="13" Margin="0,14,0,0"/>
       <TextBlock Text="✓   Your files stay at original quality" FontSize="13" Margin="0,14,0,0"/>
      </StackPanel></Border>
      <TextBlock Text="INSTALL LOCATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,22,0,6"/>
      <TextBlock x:Name="InstallPath" FontSize="12" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
      <TextBlock Text="Making room&#10;for smooth sharing." FontSize="27" FontWeight="SemiBold" LineHeight="35"/>
      <TextBlock x:Name="ProgressHint" Text="Please keep this window open." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,12,0,24"/>
      <Border Background="White" CornerRadius="18" Padding="18"><StackPanel>
       <TextBlock x:Name="StageText" Text="Preparing your installation…" FontSize="16" FontWeight="SemiBold"/>
       <Grid x:Name="InstallTrack" Height="5" ClipToBounds="True" Margin="0,16,0,18">
        <Border Background="#E4F3EC" CornerRadius="3"/>
        <Border Width="104" HorizontalAlignment="Left" Background="#007E70" CornerRadius="3"><Border.RenderTransform><TranslateTransform x:Name="ProgressSweep"/></Border.RenderTransform></Border>
       </Grid>
       <TextBlock x:Name="StepsText" Text="○ Prepare installation&#10;○ Copy application files&#10;○ Configure local receiving&#10;○ Add startup and shortcuts" LineHeight="27" FontSize="12" Foreground="{StaticResource Muted}"/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
      <Border x:Name="ResultIconBox" Background="#DDF1E8" Width="58" Height="58" CornerRadius="19" HorizontalAlignment="Left"><TextBlock x:Name="ResultIcon" Text="✓" Foreground="#007E70" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock x:Name="ResultTitle" Text="All set. Share away." FontSize="27" FontWeight="SemiBold" Margin="0,20,0,12"/>
      <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ResultDetail" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Muted}" LineHeight="21"><TextBlock.ContextMenu><ContextMenu><MenuItem Header="Copy details" Click="CopyDetails_Click"/></ContextMenu></TextBlock.ContextMenu></TextBlock></ScrollViewer>
      <Border Background="White" CornerRadius="18" Padding="18" Margin="0,24,0,0"><TextBlock x:Name="ResultNote" Text="Receiving starts automatically when you sign in. You can open Next Share from the desktop or Start menu." TextWrapping="Wrap" FontSize="13" LineHeight="21"/></Border>
     </StackPanel>
    </Grid>
    <DockPanel Grid.Row="2" LastChildFill="True">
     <Button x:Name="ActionButton" DockPanel.Dock="Right" Content="Install Next Share →" Click="Action_Click" MinWidth="146" IsDefault="True" Margin="14,0,0,0"/>
     <TextBlock x:Name="Footer" Text="Administrator access once.&#10;Exit Next Share before upgrading." Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="16"/>
    </DockPanel>
   </Grid>
   <Border Grid.ColumnSpan="2" Height="42" VerticalAlignment="Top" Background="Transparent" Margin="0,0,52,0" MouseLeftButtonDown="DragWindow"/>
  </Grid>
 </Border>
</Window>
